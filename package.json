{
  "name": "drt",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/node.js",
    "serve": "vite preview",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "test": "node --test src/server/*.test.ts src/server/planner/*.test.ts src/lib/*.test.ts",
    "test:night": "node --test tests/night.integration.ts",
    "colors": "node scripts/radix-colors.ts",
    "generate:auth": "pnpx auth generate -y --output src/lib/schema.ts",
    "generate:db": "drizzle-kit generate",
    "generate": "pnpm run generate:auth && pnpm run generate:db",
    "migrate": "drizzle-kit migrate",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@solidjs/diagnostics": "^2.0.0-rc.21",
    "@solidjs/start-devtools": "^1.0.0-next.8",
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-plugin-solid": "~0.18.1",
    "filesystem-routing": "0.5.0",
    "oxfmt": "^0.77.0",
    "oxlint": "~1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@libsql/client": "^0.18.0",
    "@remix-run/cookie": "^1.0.2",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.21",
    "better-auth": "^1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "jsqr": "1.4.0",
    "mailgun.js": "^14.1.1",
    "solid-js": "^2.0.0-rc.21",
    "tailwind-variants": "^4.0.1",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0"
  }
}
