{
  "name": "drt",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/node.js",
    "serve": "vite preview",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "generate:auth": "pnpx auth generate -y --output src/lib/schema.ts",
    "generate:db": "drizzle-kit generate",
    "generate:colors": "node scripts/radix-colors.ts",
    "generate": "pnpm run generate:auth && pnpm run generate:db",
    "migrate": "drizzle-kit migrate"
  },
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@solidjs/diagnostics": "^2.0.0-rc.20",
    "@solidjs/start-devtools": "^1.0.0-next.4",
    "@solidjs/vite-plugin": "^3.0.0-next.54",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.2.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-plugin-solid": "~0.18.1",
    "filesystem-routing": "0.4.2",
    "oxfmt": "^0.76.0",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@libsql/client": "^0.18.0",
    "@remix-run/cookie": "^0.5.4",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.43",
    "@solidjs/web": "^2.0.0-rc.20",
    "better-auth": "^1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "solid-js": "^2.0.0-rc.20",
    "valibot": "^1.4.2"
  }
}